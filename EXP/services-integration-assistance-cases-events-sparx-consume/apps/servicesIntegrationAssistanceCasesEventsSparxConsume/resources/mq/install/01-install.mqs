DEFINE QLOCAL('SERVICES_MQ_INCOMING_SPARX_CASES_EVENTS_1') +
DEFPSIST(YES) +
DESCR('Queue Local for incoming BOM Cases') +
GET(ENABLED) +
PUT(ENABLED) +
MAXDEPTH(5000) +
MAXMSGL(1048576) +
REPLACE

DEFINE QALIAS('A.SERVICES_MQ_INCOMING_SPARX_CASES_EVENTS_1') +
TARGET(SERVICES_MQ_INCOMING_SPARX_CASES_EVENTS_1) +
TARGTYPE(QUEUE) +
DEFPSIST(YES) +
REPLACE

DEFINE SUB('SUB_SERVICES_MQ_SPARX_CASES_EVENTS_1') +
TOPICOBJ('SERVICES_MQ_ASSISTANCE_V2_CASES_EVENTS_TOPIC') +
TOPICSTR('#') +
SELECTOR('FTserviceCharacteristics LIKE ''%371002%''') +
DEST('A.SERVICES_MQ_INCOMING_SPARX_CASES_EVENTS_1') +
REPLACE

DEFINE TOPIC ('SERVICES_MQ_INCOMING_SFCAS_OUTCOME_TOPIC') +
TYPE(LOCAL) DEFPSIST(YES) TOPICSTR('services/outcome') +
DESCR('Topic for outgoing notification for cases or services changes v2') +
REPLACE
