CREATE FUNCTION parseExceptionList(IN exlist_in REFERENCE, OUT number_out INTEGER, OUT text_out CHARACTER, OUT stacktrace_out CHARACTER)
BEGIN
	-- The complete statck trace of the exception (result of the loop into the tree) 
	DECLARE completeStackTrace CHARACTER '';
	-- Reference on the ExceptionList tree
	DECLARE refExceptionList REFERENCE TO exlist_in.*[1];
	-- Loop into the tree through the ExceptionList children
	WHILE refExceptionList.Number IS NOT NULL DO
		SET completeStackTrace = CAST(refExceptionList.Number AS CHARACTER) || ':' || refExceptionList.Text || ':' || COALESCE(refExceptionList.Label, '') || '
		'|| completeStackTrace ;
		MOVE refExceptionList LASTCHILD;
	END WHILE;
	-- Return the last exepction number and text and the complete stack trace
	SET number_out = refExceptionList.Number;
	SET text_out = refExceptionList.Text;
	SET stacktrace_out = completeStackTrace;
END;

CREATE FUNCTION isNumber(IN toCast CHARACTER) RETURNS BOOLEAN BEGIN
	DECLARE numCondition INTEGER CAST(toCast AS INTEGER DEFAULT -99999);
	RETURN numCondition <> -99999;
END ;

CREATE FUNCTION containsString (IN sInput CHARACTER, IN sToSearch CHARACTER, IN sSep CHARACTER) RETURNS BOOLEAN BEGIN
	DECLARE iPos INTEGER;
	DECLARE sCur CHARACTER;
	REPEAT		
		SET iPos = POSITION(sSep IN sInput);		
		IF iPos > 0 THEN
			SET sCur = LEFT(sInput, iPos - 1);
			SET sInput = SUBSTRING(sInput FROM iPos + LENGTH(sSep));
		ELSE
			SET sCur = sInput;
			SET sInput = '';
		END IF;
		IF (sCur = sToSearch) THEN
			RETURN TRUE; 
		END IF;
		UNTIL iPos = 0
	END REPEAT;
	RETURN FALSE;
END;

CREATE FUNCTION translateSpecialCharForNames(IN aString CHAR) RETURNS CHAR
BEGIN
	DECLARE finalString CHAR '';
	-- lower case
	SET finalString = TRANSLATE (aString, 'áàâãªä', 'aaaaaa');
	SET finalString = TRANSLATE (finalString, 'íìîï', 'iiii');
	SET finalString = TRANSLATE (finalString, 'éèêë', 'eeee');
	SET finalString = TRANSLATE (finalString, 'óòôõºö', 'oooooo');
	SET finalString = TRANSLATE (finalString, 'úùûü', 'uuuu');
	SET finalString = TRANSLATE (finalString, 'çñ', 'cn');
	-- upper case
	SET finalString = TRANSLATE (finalString, 'ÁÀÂÃÄ', 'AAAAA');
	SET finalString = TRANSLATE (finalString, 'ÍÌÎÏ', 'IIII');
	SET finalString = TRANSLATE (finalString, 'ÉÈÊË', 'EEEE');
	SET finalString = TRANSLATE (finalString, 'ÓÒÔÕÖ', 'OOOOO');
	SET finalString = TRANSLATE (finalString, 'ÚÙÛÜ', 'UUUU');
	SET finalString = TRANSLATE (finalString, 'ÇÑ', 'CN');
	-- others
	SET finalString = TRANSLATE (finalString, '''<>`,"«»„-', '          ');
	SET finalString = TRANSLATE (finalString, ' ', ' '); 
	SET finalString = TRIM(finalString);
	RETURN finalString;
END;
	
	
