

CREATE COMPUTE MODULE Set_params_Case_update_compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();		
		
		CALL PrepareRequestHeaders (OutputRoot, InputLocalEnvironment);
		CALL PrepareUrlForRequest ( OutputLocalEnvironment, InputLocalEnvironment,  '/cases/{case-id}', 'PUT');
		RETURN TRUE;
	END;


	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
