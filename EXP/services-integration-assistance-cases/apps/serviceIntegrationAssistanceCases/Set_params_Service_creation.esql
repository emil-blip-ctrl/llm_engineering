

CREATE COMPUTE MODULE Set_params_service_creation_compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();		
		
		CALL PrepareRequestHeaders (OutputRoot, InputLocalEnvironment);
		CALL PrepareUrlForRequest ( OutputLocalEnvironment, InputLocalEnvironment,  '/cases/{case-id}/services', 'POST');
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
