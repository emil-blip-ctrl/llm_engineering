BROKER SCHEMA sansys

CREATE COMPUTE MODULE PrepareReceivableDocumentRequest
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputLocalEnvironment = InputLocalEnvironment;
		SET OutputLocalEnvironment.Destination.HTTP.RequestURL = Environment.Variables.Policy.RequestURL_invoice;
		SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json';
		SET OutputLocalEnvironment.Destination.HTTP.RequestLine.Method = 'POST';
		
		CREATE FIELD OutputRoot.JSON.Data TYPE JSON.Array;
		DECLARE outRef REFERENCE TO OutputRoot.JSON.Data;
        
		DECLARE invoiceCount INTEGER CARDINALITY(InputRoot.JSON.Data.invoices.[]);
		DECLARE I INTEGER 1;
		
		WHILE I <= invoiceCount DO
			DECLARE refInvoice REFERENCE TO InputRoot.JSON.Data.invoices.[I];
			DECLARE transportNumber CHARACTER GetReferenceIdentifier(refInvoice.intervention.references, 'TRANSPORT_NUMBER');
			DECLARE caseNumber CHARACTER GetReferenceIdentifier(refInvoice.intervention.references, 'CASE_NUMBER');
			DECLARE bukrs CHARACTER;
			
			IF transportNumber = '' THEN
				SET transportNumber = GetReferenceIdentifier(refInvoice.references, 'TRANSPORT_NUMBER');
			END IF;
			IF caseNumber = '' THEN
				SET caseNumber = GetReferenceIdentifier(refInvoice.references, 'CASE_NUMBER');
			END IF;
			
			SET bukrs = ResolveBukrs(COALESCE(CAST(refInvoice.intervention.base_id AS CHARACTER), ''));
			
			IF bukrs = 'POLICY_NOT_FOUND' OR bukrs = 'PROPERTY_NOT_FOUND' OR COALESCE(TRIM(bukrs), '') = '' THEN
				SET Environment.sapCallFail = 'true';
				SET Environment.Variables.ErrorRefApp = 'ACEFONC0023';
				SET Environment.Variables.Info.moreInformation = 'Unknown base_id - no bukrs mapping found for base_id ''' || COALESCE(CAST(refInvoice.intervention.base_id AS CHARACTER), '') || '''.';
				SET Environment.Variables.TCSLog.context.severity = 'ERR';
				SET Environment.Variables.TCSLog.context."error-code" = Environment.Variables.ErrorRefApp;
				SET Environment.Variables.TCSLog.context."error-message" = Environment.Variables.Info.moreInformation;
				PROPAGATE TO TERMINAL 'out1' DELETE NONE;
				RETURN FALSE;
			END IF;
			
			CREATE FIELD outRef.Item[I];
	        DECLARE refItem REFERENCE TO outRef.Item[I];
	        
	        CREATE FIELD refItem."processControl"."specificationIdentifier" TYPE JSON.Array;
	        SET refItem."processControl"."specificationIdentifier".Item[1].content = 'AMBULANCE_TRANSPORT_BILLING';
	        
	        IF refInvoice.document_type = 1 THEN
	        	SET refItem."invoiceTypeCode".content = 380;
	        ELSEIF refInvoice.document_type = 2 THEN
	        	SET refItem."invoiceTypeCode".content = 381;
	        ELSE
	        	SET refItem."invoiceTypeCode".content = refInvoice.document_type;
	        END IF;

	        SET refItem."invoiceCurrencyCode".content = 'CHF';
			SET refItem."precendingInvoiceReference".content = COALESCE(refInvoice.invoice_id, '');
	             
	        CREATE FIELD refItem."invoiceNumber" TYPE JSON.Array;
	        SET refItem."invoiceNumber".Item[1].content = CAST(refInvoice.id AS CHARACTER);
	        SET refItem."invoiceNumber".Item[1]."schemeIdentifier" = 'INVOICE_ID';
	        SET refItem."invoiceNumber".Item[2].content = transportNumber;
	        SET refItem."invoiceNumber".Item[2]."schemeIdentifier" = 'TRANSPORT_NUMBER';
	
	        SET refItem."invoiceIssueDate".content = refInvoice.date;
	
	        SET refItem.seller."sellerName".content = 'SANSYS';
	        SET refItem.seller."sellerPostalAddress"."countryCode".content = 'CH';
	        CREATE FIELD refItem.seller."sellerIdentifier" TYPE JSON.Array;
	        SET refItem.seller."sellerIdentifier".Item[1]."schemeIdentifier" = 'COMPANY_CODE';
	        SET refItem.seller."sellerIdentifier".Item[1].content = bukrs;
	
	        SET refItem."vatBreakdown"."vatCategoryTaxableAmount".content = 0;
	        SET refItem."vatBreakdown"."vatCategoryTaxAmount".content = 0;
	        SET refItem."vatBreakdown"."vatCategoryCode".content = 'E';
	
			CREATE FIELD refItem."documentTotals";
			SET refItem."documentTotals"."amountDueForPayment".content = refInvoice.total_price;
			SET refItem."documentTotals"."sumOfInvoiceLineNetAmount".content = refInvoice.total_price;
			SET refItem."documentTotals"."invoiceTotalAmountWithoutVat".content = refInvoice.total_price;
			SET refItem."documentTotals"."invoiceTotalAmountWithVat".content = refInvoice.total_price;
	
			CREATE FIELD refItem."invoiceNote" TYPE JSON.Array;
			DECLARE refInvNote REFERENCE TO refItem."invoiceNote";
			
			CALL AddInvoiceNote(refInvNote, 1, 'INTERVENTION_TYPE', COALESCE(refInvoice.intervention.type, ''));
			CALL AddInvoiceNote(refInvNote, 2, 'INTERVENTION_START_TIME', COALESCE(refInvoice.intervention.start_time, ''));
			CALL AddInvoiceNote(refInvNote, 3, 'INTERVENTION_END_TIME', COALESCE(refInvoice.intervention.end_time, ''));
			CALL AddInvoiceNote(refInvNote, 4, 'INTERVENTION_SITE_NAME', COALESCE(refInvoice.intervention.site_name, ''));
			CALL AddInvoiceNote(refInvNote, 5, 'INTERVENTION_SITE_STREET', COALESCE(refInvoice.intervention.site_street, ''));
			CALL AddInvoiceNote(refInvNote, 6, 'INTERVENTION_SITE_STREET_NUMBER', COALESCE(refInvoice.intervention.site_street_number, ''));
			CALL AddInvoiceNote(refInvNote, 7, 'INTERVENTION_SITE_COMPLEMENT', COALESCE(refInvoice.intervention.site_complement, ''));
			CALL AddInvoiceNote(refInvNote, 8, 'INTERVENTION_SITE_POSTAL_CODE', COALESCE(refInvoice.intervention.site_postal_code, ''));
			CALL AddInvoiceNote(refInvNote, 9, 'INTERVENTION_SITE_CITY', COALESCE(refInvoice.intervention.site_city, ''));
			CALL AddInvoiceNote(refInvNote, 10, 'INTERVENTION_SITE_COUNTRY_CODE', COALESCE(refInvoice.intervention.site_country_code, ''));
			CALL AddInvoiceNote(refInvNote, 11, 'INTERVENTION_DESTINATION_NAME', COALESCE(refInvoice.intervention.destination_name, ''));
			CALL AddInvoiceNote(refInvNote, 12, 'INTERVENTION_DESTINATION_STREET', COALESCE(refInvoice.intervention.destination_street, ''));
			CALL AddInvoiceNote(refInvNote, 13, 'INTERVENTION_DESTINATION_STREET_NUMBER', COALESCE(refInvoice.intervention.destination_street_number, ''));
			CALL AddInvoiceNote(refInvNote, 14, 'INTERVENTION_DESTINATION_COMPLEMENT', COALESCE(refInvoice.intervention.destination_complement, ''));
			CALL AddInvoiceNote(refInvNote, 15, 'INTERVENTION_DESTINATION_POSTAL_CODE', COALESCE(refInvoice.intervention.destination_postal_code, ''));
			CALL AddInvoiceNote(refInvNote, 16, 'INTERVENTION_DESTINATION_CITY', COALESCE(refInvoice.intervention.destination_city, ''));
			CALL AddInvoiceNote(refInvNote, 17, 'INTERVENTION_DESTINATION_COUNTRY_CODE', COALESCE(refInvoice.intervention.destination_country_code, ''));
			CALL AddInvoiceNote(refInvNote, 18, 'PATIENT_INSURANCE_POLICY_NUMBER', COALESCE(refInvoice.patient.insurance_policy_number, ''));
			CALL AddInvoiceNote(refInvNote, 19, 'PATIENT_CATEGORY_ID', COALESCE(refInvoice.patient.category_id, ''));
			CALL AddInvoiceNote(refInvNote, 20, 'PATIENT_CATEGORY_NAME', COALESCE(refInvoice.patient.category_name, ''));
			CALL AddInvoiceNote(refInvNote, 21, 'PATIENT_LASTNAME', COALESCE(refInvoice.patient.lastname, ''));
			CALL AddInvoiceNote(refInvNote, 22, 'PATIENT_FIRSTNAME', COALESCE(refInvoice.patient.firstname, ''));
			CALL AddInvoiceNote(refInvNote, 23, 'PATIENT_BIRTHDATE', COALESCE(refInvoice.patient.birthdate, ''));
			CALL AddInvoiceNote(refInvNote, 24, 'PATIENT_STREET', COALESCE(refInvoice.patient.street, ''));
			CALL AddInvoiceNote(refInvNote, 25, 'PATIENT_STREET_NUMBER', COALESCE(refInvoice.patient.street_number, ''));
			CALL AddInvoiceNote(refInvNote, 26, 'PATIENT_COMPLEMENT', COALESCE(refInvoice.patient.complement, ''));
			CALL AddInvoiceNote(refInvNote, 27, 'PATIENT_PO_BOX', COALESCE(refInvoice.patient.po_box, ''));
			CALL AddInvoiceNote(refInvNote, 28, 'PATIENT_POSTAL_CODE', COALESCE(refInvoice.patient.postal_code, ''));
			CALL AddInvoiceNote(refInvNote, 29, 'PATIENT_CITY', COALESCE(refInvoice.patient.city, ''));
			CALL AddInvoiceNote(refInvNote, 30, 'PATIENT_CANTON_ID', COALESCE(refInvoice.patient.canton_id, ''));
			CALL AddInvoiceNote(refInvNote, 31, 'PATIENT_COUNTRY_CODE', COALESCE(refInvoice.patient.country_code, ''));
			CALL AddInvoiceNote(refInvNote, 32, 'PATIENT_COUNTRY_NAME', COALESCE(refInvoice.patient.country_name, ''));
			CALL AddInvoiceNote(refInvNote, 33, 'PATIENT_INSURANCE_NAME', COALESCE(refInvoice.patient.insurance_name, ''));
			CALL AddInvoiceNote(refInvNote, 34, 'INTERVENTION_ID', COALESCE(refInvoice.intervention.id, ''));
			CALL AddInvoiceNote(refInvNote, 35, 'INTERVENTION_KILOMETERS', COALESCE(refInvoice.intervention.kilometers, ''));
			CALL AddInvoiceNote(refInvNote, 36, 'INTERVENTION_ORGANIZATION_ID', COALESCE(refInvoice.intervention.organization_id, ''));
			CALL AddInvoiceNote(refInvNote, 37, 'INTERVENTION_ORGANIZATION_NAME', COALESCE(refInvoice.intervention.organization_name, ''));
			CALL AddInvoiceNote(refInvNote, 38, 'INTERVENTION_BASE_ID', COALESCE(refInvoice.intervention.base_id, ''));
			CALL AddInvoiceNote(refInvNote, 39, 'INTERVENTION_BASE_NAME', COALESCE(refInvoice.intervention.base_name, ''));
			CALL AddInvoiceNote(refInvNote, 40, 'PARTNER_TYPE_ID', COALESCE(refInvoice.debtor.type_id, ''));
			CALL AddInvoiceNote(refInvNote, 41, 'PARTNER_TYPE_NAME', COALESCE(refInvoice.debtor.type_name, ''));
			CALL AddInvoiceNote(refInvNote, 42, 'INVOICE_REFERENCE', COALESCE(refInvoice.reference, ''));
			CALL AddInvoiceNote(refInvNote, 43, 'COMMENTS', COALESCE(refInvoice.comments, ''));
			CALL AddInvoiceNote(refInvNote, 44, 'PATIENT_LEGAL_REPRESENTATIVE_ID', COALESCE(refInvoice.patient.legal_representative_id, ''));
			CALL AddInvoiceNote(refInvNote, 45, 'PATIENT_LEGAL_REPRESENTATIVE_NAME', COALESCE(refInvoice.patient.legal_representative_name, ''));
			CALL AddInvoiceNote(refInvNote, 46, 'INTERVENTION_CASE_NUMBER', COALESCE(caseNumber, ''));
			CALL AddInvoiceNote(refInvNote, 47, 'PATIENT_ID', COALESCE(refInvoice.patient.id, ''));
			
			CREATE FIELD refItem.buyer."buyerIdentifier" TYPE JSON.Array;
			SET refItem.buyer."buyerIdentifier".Item[1]."schemeIdentifier" = 'SANSYS';
			SET refItem.buyer."buyerIdentifier".Item[1].content = StripHyphen(COALESCE(CAST(refInvoice.debtor.code AS CHARACTER), ''));
			
			IF refInvoice.debtor.type_id = 2 THEN
				SET refItem.buyer."buyerTradingName".content = COALESCE(refInvoice.debtor.name, '');
			END IF;
			
			IF refInvoice.debtor.type_id = 1 THEN
				SET refItem.buyer."buyerName".content =
				CASE 
			        WHEN refInvoice.debtor.lastname IS NOT NULL AND refInvoice.debtor.firstname IS NOT NULL THEN 
			        	COALESCE(refInvoice.debtor.lastname, '') || '|' || COALESCE(refInvoice.debtor.firstname, '')
			        WHEN refInvoice.debtor.lastname IS NOT NULL THEN 
			        	COALESCE(refInvoice.debtor.lastname, '') || '|'
			   		WHEN refInvoice.debtor.firstname IS NOT NULL THEN 
			         	'|' || COALESCE(refInvoice.debtor.firstname, '')
			    	ELSE ''
			  	END;
			END IF;
			
			SET refItem.buyer."buyerPostalAddress"."addressLine1".content =
				CASE 
			      	WHEN refInvoice.debtor.street IS NOT NULL AND refInvoice.debtor.street_number IS NOT NULL THEN 
			      		COALESCE(refInvoice.debtor.street, '') || '|' || COALESCE(refInvoice.debtor.street_number, '')
			      	WHEN refInvoice.debtor.street IS NOT NULL THEN 
			      		COALESCE(refInvoice.debtor.street, '')
			      	WHEN refInvoice.debtor.street_number IS NOT NULL THEN 
			      		COALESCE(refInvoice.debtor.street_number, '')
			  		ELSE ''
			  	END;
			
			SET refItem.buyer."buyerPostalAddress"."addressLine2".content = COALESCE(refInvoice.debtor.complement, '');	
			SET refItem.buyer."buyerPostalAddress"."addressLine3".content = COALESCE(refInvoice.debtor.po_box, '');		
			SET refItem.buyer."buyerPostalAddress"."postCode".content = COALESCE(refInvoice.debtor.postal_code, '');		
			SET refItem.buyer."buyerPostalAddress".city.content = COALESCE(refInvoice.debtor.city, '');
			SET refItem.buyer."buyerPostalAddress"."countryCode".content = COALESCE(refInvoice.debtor.country_code, '');	
					    
			CREATE FIELD refItem."invoiceLine" TYPE JSON.Array;		
			DECLARE articleRef REFERENCE TO refInvoice.articles.Item[1];
			DECLARE articleIndex INTEGER 1;
			
			WHILE LASTMOVE(articleRef) DO
				SET refItem."invoiceLine".Item[articleIndex]."itemInformation"."itemDescription".content = COALESCE(articleRef.line_2, '');
				SET refItem."invoiceLine".Item[articleIndex]."itemInformation"."itemName".content = COALESCE(articleRef.line_1, '');
			
			    CREATE FIELD refItem."invoiceLine".Item[articleIndex]."itemInformation"."itemSellersIdentifier" TYPE JSON.Array;
			    SET refItem."invoiceLine".Item[articleIndex]."itemInformation"."itemSellersIdentifier".Item[1].content = COALESCE(articleRef.code, '');
			    SET refItem."invoiceLine".Item[articleIndex]."itemInformation"."itemSellersIdentifier".Item[1]."schemeIdentifier" = 'ARTICLE_CODE';
			
			    SET refItem."invoiceLine".Item[articleIndex]."invoicedQuantity".content = COALESCE(CAST(CAST(articleRef.quantity AS DECIMAL) AS CHARACTER FORMAT '##0.00'), '');
			    SET refItem."invoiceLine".Item[articleIndex]."priceDetails"."itemNetPrice".content = COALESCE(CAST(articleRef.unit_price AS CHARACTER), '');
			    SET refItem."invoiceLine".Item[articleIndex]."invoicedLineNetAmount".content = COALESCE(CAST(articleRef.price AS CHARACTER), '');
			    SET refItem."invoiceLine".Item[articleIndex]."invoicedQuantityUnitOfMeasureCode".content = COALESCE(CAST(articleRef.unit_name AS CHARACTER), '');
			    
			    MOVE articleRef NEXTSIBLING;
			    SET articleIndex = articleIndex + 1;
			END WHILE;
			
			SET I = I + 1;
		END WHILE;

		RETURN TRUE;
	END;
	
	CREATE PROCEDURE AddInvoiceNote(IN invoiceNoteRef REFERENCE, IN notePosition INTEGER, IN subjectCode CHARACTER, IN noteText CHARACTER)
	BEGIN
		SET invoiceNoteRef.Item[notePosition]."invoiceNoteSubjectCode".content = subjectCode;
		SET invoiceNoteRef.Item[notePosition]."invoiceNoteText".content = COALESCE(noteText, '');
	END;
	
	CREATE FUNCTION GetReferenceIdentifier(IN referencesRef REFERENCE, IN schemeIdentifier CHARACTER) RETURNS CHARACTER
	BEGIN
		DECLARE referencesCount INTEGER CARDINALITY(referencesRef.*[]);
		DECLARE index INTEGER 1;
		DECLARE currentSchemeIdentifier CHARACTER;
		
		WHILE index <= referencesCount DO
			DECLARE referenceEntry REFERENCE TO referencesRef.*[index];
			SET currentSchemeIdentifier = COALESCE(CAST(referenceEntry."scheme-identifier" AS CHARACTER),
												  CAST(referenceEntry.scheme_identifier AS CHARACTER),
												  CAST(referenceEntry.schemeIdentifier AS CHARACTER),
												  '');
			IF UPPER(currentSchemeIdentifier) = UPPER(schemeIdentifier) THEN
				RETURN COALESCE(CAST(referenceEntry.identifier AS CHARACTER),
								CAST(referenceEntry.content AS CHARACTER),
								'');
			END IF;
			SET index = index + 1;
		END WHILE;
		
		RETURN '';
	END;
	
	CREATE FUNCTION ResolveBukrs(IN baseId CHARACTER) RETURNS CHARACTER
	BEGIN
		DECLARE propertyName CHARACTER;
		DECLARE bukrs CHARACTER;
		
		SET propertyName = 'sansysmit_' || LOWER(COALESCE(baseId, '')) || '_bukrs';
		SET bukrs = Shlib_PoliciesReader.getPolicyPropertyWithOutError('{finance-integration-policies-endpoints}:BaseIdentityPolicy', propertyName);
		
		IF bukrs = 'POLICY_NOT_FOUND' OR bukrs = 'PROPERTY_NOT_FOUND' OR COALESCE(TRIM(bukrs), '') = '' THEN
			SET propertyName = 'sansysmit_' || COALESCE(baseId, '') || '_bukrs';
			SET bukrs = Shlib_PoliciesReader.getPolicyPropertyWithOutError('{finance-integration-policies-endpoints}:BaseIdentityPolicy', propertyName);
		END IF;
		
		IF bukrs = 'POLICY_NOT_FOUND' OR bukrs = 'PROPERTY_NOT_FOUND' OR COALESCE(TRIM(bukrs), '') = '' THEN
			SET propertyName = 'SANSYSMIT_' || COALESCE(baseId, '') || '_bukrs';
			SET bukrs = Shlib_PoliciesReader.getPolicyPropertyWithOutError('{finance-integration-policies-endpoints}:BaseIdentityPolicy', propertyName);
		END IF;
		
		RETURN bukrs;
	END;
	
	CREATE FUNCTION StripHyphen(IN inputValue CHARACTER) RETURNS CHARACTER
	BEGIN
		RETURN TRANSLATE(COALESCE(inputValue, ''), '-', '');
	END;
END MODULE;