
CREATE COMPUTE MODULE processEventFromQueueSparx_SetBusinessIdentifier_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot = InputRoot;
		DECLARE ref REFERENCE TO InputRoot.JSON.Data;
		DECLARE  vehicleLicenseplate, vehicleIdentificationNumber, serviceContractSparxReference,interfaceLink, bomCaseId, sparxCaseId CHARACTER '';
		DECLARE i INTEGER 0;
		DECLARE result ROW;

		SET bomCaseId = ref.Id;

		MOVE ref TO InputRoot.JSON.Data.ItemsUsedList.Item[1];
		WHILE lastmove(ref)
		DO
			IF i > 0
			THEN
				SET vehicleLicenseplate = vehicleLicenseplate || '|';
				SET vehicleIdentificationNumber = vehicleIdentificationNumber || '|';
			END IF;
			SET vehicleLicenseplate = vehicleLicenseplate || COALESCE(ref.ImmatriculationCountry, '') || ' ' || COALESCE(ref.Numberplate, '');
			SET vehicleIdentificationNumber = vehicleIdentificationNumber || COALESCE(ref.VIN, '');
			SET i = i + 1;
			MOVE ref NEXTSIBLING REPEAT TYPE NAME;
		END WHILE;

		SET i = 0;
		MOVE ref TO InputRoot.JSON.Data.ServiceDeliveryList.Item[1];

		WHILE lastmove(ref)
		DO
			SET result.Item = THE(SELECT I FROM ref.Coverage.ServiceContract.ExternalContractReferenceList.Item[] AS I WHERE LCASE(I.Source) = 'sparx'); 

			IF CARDINALITY(result.Item.*[]) > 0
			THEN
				IF i > 0
				THEN
					SET serviceContractSparxReference = COALESCE(result.Item.Reference, '') || '|';
				END IF;
				SET serviceContractSparxReference = serviceContractSparxReference || COALESCE(result.Item.Reference, '');
				SET i = i + 1;
			END IF;
			MOVE ref NEXTSIBLING REPEAT TYPE NAME;
		END WHILE;

		MOVE ref TO InputRoot.JSON.Data.CaseReferenceList.Item[1];
		X : WHILE lastmove(ref)
		DO
			IF UCASE(ref.Source) = 'SPARX'
			THEN
				SET interfaceLink = ref.Id;
				SET sparxCaseId = ref.Reference;
				LEAVE X;
			END IF;	
			MOVE ref NEXTSIBLING REPEAT TYPE NAME;
		END WHILE;

		SET Environment.Variables.TCSLog.context."business-identifiers".CaseInternalId = COALESCE(InputRoot.JSON.Data.InternalId, '');
 		SET Environment.Variables.TCSLog.context."business-identifiers".InterfaceLink = COALESCE(interfaceLink, '');
		SET Environment.Variables.TCSLog.context."business-identifiers".CaseReference = COALESCE(bomCaseId, '');
		SET Environment.Variables.TCSLog.context."business-identifiers".VehicleLicenseplate = COALESCE(vehicleLicenseplate, '');
		SET Environment.Variables.TCSLog.context."business-identifiers".VehicleIdentificationNumber = COALESCE(vehicleIdentificationNumber, '');
		SET Environment.Variables.TCSLog.context."business-identifiers".ServiceContractReference = COALESCE(serviceContractSparxReference, '');
		SET Environment.Variables.Sparx.Info.CaseId = COALESCE(ref.Reference, '');

		-- restore naturesOfChanges and contextsOfEvent (For naturesOfChanges Java validation => Check MessageFlowHelper)
		-- naturesOfChanges should be IN 'MANUAL_TRIGGER_SPARX, SERVICE_STATUS_CHANGED, CASE_PERFORMANCE_VALUE_CHANGED, INCIDENT_REPORT_CHANGED'
		CREATE FIELD Environment.ESB.ESBEnvelope.userDefined.request.event.(JSON.Array)naturesOfChanges;
		CREATE FIELD Environment.ESB.ESBEnvelope.userDefined.request.event.(JSON.Array)contextsOfEvent;
		CALL CommonHelper.transformStringToListDefinedSeparator(Environment.Variables.TCSLog.userDefined.naturesOfChanges,';',Environment.ESB.ESBEnvelope.userDefined.request.event.(JSON.Array)naturesOfChanges,false);
		CALL CommonHelper.transformStringToListDefinedSeparator(Environment.Variables.TCSLog.userDefined.contextsOfEvent,';',Environment.ESB.ESBEnvelope.userDefined.request.event.(JSON.Array)contextsOfEvent,false);

		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;