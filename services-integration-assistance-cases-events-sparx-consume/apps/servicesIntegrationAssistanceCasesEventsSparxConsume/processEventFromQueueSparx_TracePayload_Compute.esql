

CREATE COMPUTE MODULE processEventFromQueueSparx_TracePayload_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot = InputRoot;
		DECLARE enc INTEGER COALESCE(InputRoot.Properties.Encoding, 546);
		DECLARE charSet INTEGER COALESCE(InputRoot.Properties.CodedCharSetId, 1208);

		DECLARE paylodAsBlob BLOB;
		DECLARE payloadAsChar CHARACTER;

		IF EXISTS(InputRoot.BLOB.BLOB[])
		THEN
			SET paylodAsBlob  = InputRoot.BLOB.BLOB;
		ELSEIF EXISTS(InputRoot.JSON.Data[])
		THEN
			SET paylodAsBlob = ASBITSTREAM(InputRoot.JSON.Data CCSID charSet Encoding enc);
		END IF;

		SET payloadAsChar = CAST(paylodAsBlob AS CHAR CCSID 1208);
		SET Environment.Variables.Info.Payload = payloadAsChar;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
