

CREATE COMPUTE MODULE invoice_error
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		SET OutputLocalEnvironment = InputLocalEnvironment;
		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.Properties.ContentType = 'application/json; charset=utf-8';

		-- create the http response (http status & body)
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = Environment.Variables.HttpReturnCode;
		SET OutputRoot.JSON.Data.timestamp = CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'I');
		SET OutputRoot.JSON.Data.statusCode = Environment.Variables.ErrorProviderName || ' : ' || CAST(Environment.Variables.HttpReturnCode AS CHARACTER);
		SET OutputRoot.JSON.Data.statusMessage = Environment.Variables.ErrorProviderName || ' : ' || Environment.Variables.ExceptionMessage;
		SET OutputRoot.JSON.Data.contexteCode = Environment.Variables.ErrorRefApp;
		SET OutputRoot.JSON.Data.gtid = Environment.Variables."X-Global-Transaction-Id";
		SET OutputRoot.JSON.Data.httpCode = Environment.Variables.HttpReturnCode;
		SET OutputRoot.JSON.Data.httpMessage = Environment.Variables.ErrorProviderName || ' : ' || Environment.Variables.ExceptionMessage;
		SET OutputRoot.JSON.Data.moreInformation = Environment.Variables.ExceptionStackTrace || ' Check error referencial to get more information, contexte code = ' || Environment.Variables.ErrorRefApp;
		
		SET Environment.Variables.TCSLog.context.severity = 'ERROR';
		SET Environment.Variables.TCSLog.context."error-code" = CAST(Environment.Variables.HttpReturnCode AS CHARACTER);
		SET Environment.Variables.TCSLog.context."error-message" = OutputRoot.JSON.Data.statusMessage || '. ' || OutputRoot.JSON.Data.moreInformation;
		SET Environment.Variables.TCSLog.context.transaction.PROCESS_CONTROL = InputLocalEnvironment."business-identifiers".PROCESS_CONTROL;
		SET Environment.Variables.TCSLog.context.transaction.CLAIM_NUMBERS = InputLocalEnvironment."business-identifiers".CLAIM_NUMBERS;
		SET Environment.Variables.TCSLog.context.transaction.BUSINESS_PARTNER_REFERENCE = InputLocalEnvironment."business-identifiers".BUSINESS_PARTNER_REFERENCE;
		
		PROPAGATE TO TERMINAL 1 DELETE NONE;
		
		SET Environment.Variables.TCSLog.context.severity = 'INFO';
		DELETE FIELD Environment.Variables.TCSLog.context."error-code";
		DELETE FIELD Environment.Variables.TCSLog.context."error-message";
		
		RETURN TRUE;
	END;
	
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;

