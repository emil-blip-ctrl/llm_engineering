CREATE COMPUTE MODULE fsmCalculateWaitingTimeRequest
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DELETE FIELD Environment.Variables.Error;
		
		IF NOT EXISTS(InputRoot.JSON.Data) THEN
			CALL RaiseApplicationError(
				400,
				'Bad Request',
				'Request payload is missing or empty.',
				'SFCASFUNC0001');
		END IF;
		
		SET OutputLocalEnvironment = InputLocalEnvironment;
		SET Environment.Variables.SFCAS.Request = InputRoot.JSON.Data;
		
		DELETE FIELD OutputRoot.*[];
		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.Properties.MessageDomain = 'JSON';
		
		-- TODO: replace this pass-through with the real SFCAS -> BOM transformation
		-- from services-integration-shlib-transform-sfsc-bom when that library contract is available.
		SET OutputRoot.JSON.Data = InputRoot.JSON.Data;
		
		SET OutputLocalEnvironment.Destination.HTTP.RequestURL =
			Shlib_PoliciesReader.gestionPolicy('{common-integration-policies-endpoints}:ApicEndpointsPolicy', 'apic-host')
			|| Shlib_PoliciesReader.gestionPolicy('{services-integration-policies-endpoints}:ApicEndPoints', 'path-external-api-fsm-assistance-cases_calculatewaitingtime');
		SET OutputLocalEnvironment.Destination.HTTP.RequestLine.Method = 'POST';
		
		SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json; charset=utf-8';
		SET OutputRoot.HTTPRequestHeader."X-IBM-Client-id" =
			Shlib_PoliciesReader.gestionPolicy('{AceAppEsbCredentialsPolicies}:AceAppEsbCredentialsPolicy', 'client_id');
		SET OutputRoot.HTTPRequestHeader."X-IBM-Client-secret" =
			Shlib_PoliciesReader.gestionPolicy('{AceAppEsbCredentialsPolicies}:AceAppEsbCredentialsPolicy', 'client_secret');
		SET OutputRoot.HTTPRequestHeader."X-Global-Transaction-Id" = Environment.Variables."X-Global-Transaction-Id";
		SET OutputRoot.HTTPRequestHeader."X-Caller-Code" = ApplicationLabel;
		
		RETURN TRUE;
	END;
	
	CREATE PROCEDURE RaiseApplicationError(
		IN pHttpStatus INTEGER,
		IN pHttpMessage CHARACTER,
		IN pMoreInformation CHARACTER,
		IN pRefAppError CHARACTER)
	BEGIN
		SET Environment.Variables.Error.HttpStatusCode = pHttpStatus;
		SET Environment.Variables.Error.HttpMessage = pHttpMessage;
		SET Environment.Variables.Error.MoreInformation = pMoreInformation;
		SET Environment.Variables.Error.RefAppError = pRefAppError;
		
		THROW USER EXCEPTION CATALOG 'SFCAS' MESSAGE 1001 VALUES(pMoreInformation);
	END;
END MODULE;