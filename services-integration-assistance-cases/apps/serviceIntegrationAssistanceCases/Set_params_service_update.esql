

CREATE COMPUTE MODULE Set_params_service_update_compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyEntireMessage();		
		
		CALL PrepareRequestHeaders (OutputRoot, InputLocalEnvironment);
		CALL PrepareUrlForRequest ( OutputLocalEnvironment, InputLocalEnvironment,  '/cases/{case-id}/services/{srvc-id}', 'PUT');
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
