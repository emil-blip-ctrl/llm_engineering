DEFINE QL(L.CLAIMSTECHNICALALIS.PROCESS.BO) DEFPSIST(YES) MAXDEPTH(50000)  REPLACE

DEFINE QA(A.CLAIMSTECHNICALALIS.PROCESS.BO)  TARGET(L.CLAIMSTECHNICALALIS.PROCESS.BO) REPLACE

DEFINE QL(L.CLAIMSTECHNICALALIS.PROCESS) +
BOQNAME(A.CLAIMSTECHNICALALIS.PROCESS.BO) +
DEFPSIST(YES) +
MAXDEPTH(200000) +
REPLACE

DEFINE QA(A.CLAIMSTECHNICALALIS.PROCESS)  TARGET(L.CLAIMSTECHNICALALIS.PROCESS) REPLACE

DEFINE QLOCAL ('QL.INSURANCE.TECHNICAL.CORRESPONDANCE.ALIS') +
DEFPSIST(YES) +
BOTHRESH(2) +
DESCR('Queue Local Generated') +
MAXDEPTH(50000) +
REPLACE

DEFINE QALIAS('QA.INSURANCE.TECHNICAL.CORRESPONDANCE.ALIS') +
TARGET('QL.INSURANCE.TECHNICAL.CORRESPONDANCE.ALIS') +
TARGTYPE(QUEUE) +
DEFPSIST(NO) +
REPLACE

DEFINE SUB('SUB_INSURANCE_TECHNICAL_CORRESPONDANCE_ALIS') +
TOPICSTR('TCS/CONTENT/MGT/NOTIFICATION/ECM/EVENT/POST/1/0')  +
SELECTOR('usr.FTLINEOFBUSINESS IN (''INSURANCE'') AND usr.FTFUNCTIONAL_CONTEXT  = ''LEGAL-CLAIMS'' AND usr.FTDIRECTION IN (''INCOMING'') AND usr.FTSOURCE IN (''TCSCH'',''EMAIL'')') +
DEST('QA.INSURANCE.TECHNICAL.CORRESPONDANCE.ALIS') +
REPLACE