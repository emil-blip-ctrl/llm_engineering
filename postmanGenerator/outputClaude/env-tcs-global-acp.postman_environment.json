    { "key": "client_id-x-lexforyou", "value": "{{vault:client_id-a-lexforyou}}", "type": "default", "enabled": true },
    { "key": "client_secret-x-lexforyou", "value": "{{vault:client_secret-a-lexforyou}}", "type": "secret", "enabled": true },
    { "key": "client_id-x-assistach", "value": "{{vault:client_id-a-assistach}}", "type": "default", "enabled": true },
    { "key": "client_secret-x-assistach", "value": "{{vault:client_secret-a-assistach}}", "type": "secret", "enabled": true }
