

CREATE COMPUTE MODULE sapResponseMapping
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
	    SET OutputRoot.JSON.Data.meta.submissionId = InputRoot.JSON.Data.SapZwsFinDoc.SapTechnicalReponse.SapMeta.submissionId;
	    SET OutputRoot.JSON.Data.meta.timestamp = InputRoot.JSON.Data.SapZwsFinDoc.SapTechnicalReponse.SapMeta.TIMESTAMP;
	    SET OutputRoot.JSON.Data.data.documentId = InputRoot.JSON.Data.SapZwsFinDoc.IDOC_NUMBER;
	    SET OutputRoot.JSON.Data.data.status = InputRoot.JSON.Data.SapZwsFinDoc.SapTechnicalReponse.SapData.STATUS;
	    SET OutputRoot.JSON.Data.data.receivedCount = InputRoot.JSON.Data.SapZwsFinDoc.SapTechnicalReponse.SapData.RECEIVEDCOUNT;
	    SET OutputRoot.JSON.Data.data.message = InputRoot.JSON.Data.SapZwsFinDoc.SapTechnicalReponse.SapData.MESSAGE;
		
		IF UPPER(InputRoot.JSON.Data.SapZwsFinDoc.SapTechnicalReponse.SapData.STATUS) = 'ACCEPTED' THEN
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 202;
		ELSE 
			SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 201;
		END IF;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

END MODULE;
