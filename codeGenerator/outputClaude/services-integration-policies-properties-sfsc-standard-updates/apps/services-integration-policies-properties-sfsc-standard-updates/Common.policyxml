<?xml version="1.0" encoding="UTF-8"?>
<policies>
  <policy policyType="UserDefined" policyName="Common" policyTemplate="UserDefined">
    <DatedConversionRate_Create>{&quot;attributes&quot;:{&quot;type&quot;:&quot;DatedConversionRate&quot;},&quot;IsoCode&quot;:&quot;@@IsoCode@@&quot;,&quot;ConversionRate&quot;:@@ConversionRate@@,&quot;StartDate&quot;:&quot;@@StartDate@@&quot;}</DatedConversionRate_Create>
    <DatedConversionRate_Update>{&quot;attributes&quot;:{&quot;type&quot;:&quot;DatedConversionRate&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;ConversionRate&quot;:@@ConversionRate@@}</DatedConversionRate_Update>
    <Endpoint_CRUD>/data/v60.0/composite/sobjects</Endpoint_CRUD>
    <UpdateDocumentLinks>{&quot;allOrNone&quot;:true,&quot;collateSubrequests&quot;:false,&quot;compositeRequest&quot;:[{&quot;method&quot;:&quot;POST&quot;,&quot;url&quot;:&quot;/services/data/v60.0/sobjects/ContentVersion/&quot;,&quot;referenceId&quot;:&quot;new_version&quot;,&quot;body&quot;:{&quot;Description&quot;:&quot;@@description@@&quot;,&quot;ContentLocation&quot;:&quot;E&quot;,&quot;Title&quot;:&quot;@@title@@&quot;,&quot;ContentUrl&quot;:&quot;@@content_url@@&quot;,&quot;ExternalDataSourceId&quot;:&quot;@@id_external_datasource@@&quot;,&quot;ExternalDocumentInfo1&quot;:&quot;@@parameters_url@@&quot;,&quot;ExternalDocumentInfo2&quot;:&quot;@@onbase_id@@&quot;,&quot;TagCsv&quot;:&quot;@@tag_csv@@&quot;,&quot;Origin&quot;:&quot;H&quot;}},{&quot;method&quot;:&quot;GET&quot;,&quot;url&quot;:&quot;/services/data/v60.0/sobjects/ContentVersion/@{new_version.id}?fields=Id,ContentDocumentId&quot;,&quot;referenceId&quot;:&quot;created_version&quot;},{&quot;method&quot;:&quot;POST&quot;,&quot;url&quot;:&quot;/services/data/v60.0/sobjects/ContentDocumentLink/&quot;,&quot;referenceId&quot;:&quot;new_link&quot;,&quot;body&quot;:{&quot;ContentDocumentId&quot;:&quot;@{created_version.ContentDocumentId}&quot;,&quot;LinkedEntityId&quot;:&quot;@@object_id@@&quot;}}]}</UpdateDocumentLinks>
    <PaymentRequest_GetIds>{&quot;ids&quot;:[@@Ids@@],&quot;fields&quot;:[&quot;Id&quot;,&quot;Name&quot;,&quot;Status&quot;]}</PaymentRequest_GetIds>
    <PaymentRequest_Endpoint>/PaymentRequest</PaymentRequest_Endpoint>
    <PaymentRequest_Error>{&quot;attributes&quot;:{&quot;type&quot;:&quot;PaymentRequest&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;IntegrationMessage__c&quot;:&quot;@@Message@@&quot;,&quot;IntegrationCode__c&quot;:&quot;@@Code@@&quot;}</PaymentRequest_Error>
    <PaymentRequest_Error_Posted>{&quot;attributes&quot;:{&quot;type&quot;:&quot;PaymentRequest&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;Status&quot;:&quot;In progress&quot;,&quot;IntegrationMessage__c&quot;:&quot;@@Message@@&quot;,&quot;IntegrationCode__c&quot;:&quot;@@Code@@&quot;}</PaymentRequest_Error_Posted>
    <PaymentRequest_Status_Booked>{&quot;attributes&quot;:{&quot;type&quot;:&quot;PaymentRequest&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;SAPDocumentNumber__c&quot;:&quot;@@SapDocN@@&quot;,&quot;Status&quot;:&quot;Booked&quot;}</PaymentRequest_Status_Booked>
    <PaymentRequest_Status_Paid>{&quot;attributes&quot;:{&quot;type&quot;:&quot;PaymentRequest&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;Status&quot;:&quot;Paid&quot;,&quot;PaymentDate__c&quot;:&quot;@@CurrentDate@@&quot;}</PaymentRequest_Status_Paid>
    <PaymentRequest_InvalidStatus_Payment>{&quot;attributes&quot;:{&quot;type&quot;:&quot;PaymentRequest&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;IntegrationMessage__c&quot;:&quot;Payment received from SAP - Invalid status&quot;,&quot;IntegrationCode__c&quot;:&quot;Payment&quot;}</PaymentRequest_InvalidStatus_Payment>
    <PaymentRequest_InvalidStatus_Invoice>{&quot;attributes&quot;:{&quot;type&quot;:&quot;PaymentRequest&quot;},&quot;Id&quot;:&quot;@@Id@@&quot;,&quot;IntegrationMessage__c&quot;:&quot;Accounting acknowledge received from SAP - Invalid status&quot;,&quot;IntegrationCode__c&quot;:&quot;Accounting&quot;}</PaymentRequest_InvalidStatus_Invoice>
    <PaymentRequest_GetIds_MaxObject>2000</PaymentRequest_GetIds_MaxObject>
    <PaymentRequest_UpdateRecords_MaxObject>200</PaymentRequest_UpdateRecords_MaxObject>
    <composite-endpoint>/data/v60.0/composite</composite-endpoint>
  </policy>
</policies>