CREATE COMPUTE MODULE fsmErrorHandler
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
			
		SET OutputRoot.JSON.Data.timestamp = CURRENT_TIMESTAMP;
		SET OutputRoot.JSON.Data.httpCode = 502;
		SET OutputRoot.JSON.Data.httpMessage = 'Bad Gateway';
		SET OutputRoot.JSON.Data.moreInformation = 'The upstream FSM API (external-api-fsm-assistance-cases) returned a non-2xx response.';
		SET OutputRoot.JSON.Data.gtid = Environment.Variables."X-Global-Transaction-Id";
		SET OutputRoot.JSON.Data.refAppError = 'SFCASTECH0001';
		
		--ReplyStatusCode
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 502;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;