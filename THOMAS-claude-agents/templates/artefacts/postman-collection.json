{
  "info": {
    "name": "<Collection Name> — Non-Regression",
    "description": "Non-regression test collection. Generated by /postman-collection-generator skill.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "{{REPLACE_WITH_UUID}}"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{BASE_URL}}", "type": "string" },
    { "key": "apiKey", "value": "{{API_KEY}}", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "Verify API is reachable"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
