    <translation xmi:type="utility:TranslatableString" key="cc_app_mq_start" bundleName="common_integration_shlib_encapsulate_calls/cc_app_mq_start" pluginId="common-integration-shlib-encapsulate-calls"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/common-integration-shlib-encapsulate-calls/icons/full/obj16/cc_app_mq_start.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/common-integration-shlib-encapsulate-calls/icons/full/obj30/cc_app_mq_start.gif"/>
    <shortDescription xmi:type="utility:ConstantString" string="Manage Mq message bulf with &quot;wrap message&quot; shlib"/>
    <longDescription xmi:type="utility:ConstantString" string="The choice was to unuse the failure output terminal. &#xD;&#xA;&#xD;&#xA;With failure output terminal connected, if there's a defined backout threshold in the input MQ queue, the message is propagated  as many times through the output terminal input node  as through the failure terminal input node. &#xD;&#xA;&#xD;&#xA;So, if there's a problem through the failure output terminal, the message will be rolled back then reprocessed to the failure output terminal as many time the backout threshold is not reached again&#xD;&#xA;&#xD;&#xA;For example, if backout threashold is set to 3 and if there is error in output terminal and also in failure terminal, the node read the message twice 3 times (Fist :  3 times though output terminal, then 3 times through failure terminal)&#xD;&#xA;&#xD;&#xA;But, by unconnected failure terminal, the message is not propagated through failure terminal and it moved to BO queue (if defined, if not moved to DLQ, if not message lost)&#xD;&#xA;&#xD;&#xA;"/>
    <composition>
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="28,114" queueName="ToBeOverRided" policyUrl="{GlobalMQPolicies}:RemoteMQPolicies">
        <translation xmi:type="utility:ConstantString" string="MQ Input"/>
        <monitorEvents eventSourceDescription="Transaction start" eventSourceName="MQ Input.transaction.Start" eventIdentity="Start Mq input">
          <eventXMLDoc xmi:type="mbmonitor:MonitorEvent" eventUOW="none">
            <globalTransactionCorrelator dataLocation="$Root/MQRFH2/usr/gtid" eventCorrelation="dataLocation"/>
            <parentTransactionCorrelator/>
            <localTransactionCorrelator/>
            <bitStreamData encoding="none" bitstreamContent="none"/>
            <eventName literal="Start Mq input"/>
            <eventFilter dataLocation="true()" isXPath="true"/>
          </eventXMLDoc>
        </monitorEvents>
        <monitorEvents eventSourceDescription="Catch terminal" eventSourceName="MQ Input.terminal.catch" eventIdentity="$Environment/Variables/MonitoringMessageCatch">
          <eventXMLDoc xmi:type="mbmonitor:MonitorEvent" eventUOW="none">
            <applicationData dataLocation="$ExceptionList" isXPath="true" complexData="true"/>
            <globalTransactionCorrelator dataLocation="$Root/MQRFH2/usr/gtid" eventCorrelation="dataLocation"/>
            <parentTransactionCorrelator/>
            <localTransactionCorrelator/>
            <bitStreamData encoding="none" bitstreamContent="none"/>
            <eventName dataLocation="$Environment/Variables/MonitoringMessageCatch" isXPath="true"/>
            <eventFilter dataLocation="true()" isXPath="true"/>
          </eventXMLDoc>
        </monitorEvents>
      </nodes>
      <nodes xmi:type="eflow:FCMSink" xmi:id="OutTerminal.Out" location="656,115">
        <translation xmi:type="utility:TranslatableString" key="OutTerminal.Out" bundleName="common_integration_shlib_encapsulate_calls/cc_app_mq_start" pluginId="common-integration-shlib-encapsulate-calls"/>
