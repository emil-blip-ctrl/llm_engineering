    <shortDescription xmi:type="utility:ConstantString" string="Used at the end in a MQ Application flow to set up context for monitoring"/>
    <longDescription xmi:type="utility:ConstantString" string="When using a MQ Application flow, add this this subflow at the end of the design flow. This set differents informations based on the input message (X-Caller-Code, X-Global-Transaction-Id etc..) to &#xD;&#xA;- populate environment variables used to create entries in ELK &#xD;&#xA;&#xD;&#xA;Before this subflow, if business-identifiers has to be defined in TCS monitoring, please create this input tree&#xD;&#xA;&#xD;&#xA;LocalEnvironment.&quot;business-identifiers&quot;.key1 = 'Value1';&#xD;&#xA;LocalEnvironment.&quot;business-identifiers&quot;.key2 = 'Value2';"/>
    <composition>
      <nodes xmi:type="eflow:FCMSource" xmi:id="InTerminal.Input" location="20,20">
        <translation xmi:type="utility:TranslatableString" key="InTerminal.Input" bundleName="common_integration_shlib_encapsulate_calls/cc_app_mq_end" pluginId="common-integration-shlib-encapsulate-calls"/>
      </nodes>
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="157,29" dataSource="ACE_CONTEXTREFERENCE_DB" computeExpression="esql://routine/common_integration_shlib_encapsulate_calls#cc_app_mq_end_ExitPoint.Main" computeMode="destinationAndMessage">
        <translation xmi:type="utility:ConstantString" string="ExitPoint"/>
        <monitorEvents eventSourceDescription="Out terminal" eventSourceName="ExitPoint.terminal.out" eventIdentity="$Environment/Variables/MonitoringMessage">
          <eventXMLDoc xmi:type="mbmonitor:MonitorEvent" eventUOW="none">
            <applicationData dataLocation="$Environment/Variables/TCSLog/context/*" isXPath="true" complexData="true"/>
            <applicationData dataLocation="$LocalEnvironment/business-identifiers" isXPath="true" complexData="true"/>
            <globalTransactionCorrelator/>
            <parentTransactionCorrelator/>
            <localTransactionCorrelator/>
            <bitStreamData encoding="none" bitstreamContent="none"/>
            <eventName dataLocation="$Environment/Variables/MonitoringMessage" isXPath="true"/>
            <eventFilter dataLocation="true()" isXPath="true"/>
          </eventXMLDoc>
        </monitorEvents>
      </nodes>
