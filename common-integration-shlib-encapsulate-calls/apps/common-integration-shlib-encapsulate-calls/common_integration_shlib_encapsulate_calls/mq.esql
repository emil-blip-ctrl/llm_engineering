	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputLocalEnvironment = InputLocalEnvironment;
		DELETE FIELD OutputLocalEnvironment."business-identifiers";
		SET OutputRoot = InputRoot;
		SET Environment.Variables.MonitoringMessage = 'SUP: RECEIVE get message from queue ' || queueName;
		PROPAGATE TO TERMINAL 'out1' DELETE NONE;
