

CREATE COMPUTE MODULE invoice_handling_error
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		-- parse the exception list tree (if there is one) in order to fill the http response returned afterwards
		IF EXISTS(InputExceptionList.*[]) THEN
			CALL parseExceptionList(InputExceptionList, Environment.Variables.ExceptionNumber, Environment.Variables.ExceptionMessage, Environment.Variables.ExceptionStackTrace);
			CREATE LASTCHILD OF Environment.Variables.StringifyError DOMAIN 'JSON' ;
			set Environment.Variables.StringifyError.JSON.Data = InputExceptionList; 
			DECLARE jsonAsBlob BLOB ASBITSTREAM(Environment.Variables.StringifyError.JSON.Data CCSID COALESCE(InputRoot.Properties.CodedCharSetId,1208));
			DECLARE jsonAsChar CHAR CAST(jsonAsBlob AS CHAR CCSID 1208);
			set Environment.Variables.ExceptionStackTrace = jsonAsChar;
		END IF;
		
		-- check provider, if empty this means that it's necessarily ACE that is causing the error 
		SET Environment.Variables.ErrorProviderName = COALESCE(Environment.Variables.ErrorProviderName, 'ACE');
		
		-- check if the environment contains an http status error code to return (if not by default we return 500) 
		IF Environment.Variables.HttpReturnCode IS NULL OR CARDINALITY(Environment.Variables.HttpReturnCode[]) = 0 THEN
			SET Environment.Variables.HttpReturnCode = 500;
		END IF;
		
		IF Environment.Variables.ErrorRefApp IS NULL OR CARDINALITY(Environment.Variables.ErrorRefApp[]) = 0 THEN
			SET Environment.Variables.ErrorRefApp = 'ACETECH0001';
		END IF;

		-- create the http response (http status & body)
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = Environment.Variables.HttpReturnCode;
		SET OutputRoot.JSON.Data.timestamp = CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'I');
		SET OutputRoot.JSON.Data.httpCode = Environment.Variables.ErrorProviderName || ' : ' || CAST(COALESCE(Environment.Variables.ErrorProviderHttpReturnCode, Environment.Variables.HttpReturnCode) AS CHARACTER);
		SET OutputRoot.JSON.Data.httpMessage = Environment.Variables.ErrorProviderName || ' : ' || COALESCE(Environment.Variables.ExceptionMessage, 'No exception message !');
		SET OutputRoot.JSON.Data.refAppError = Environment.Variables.ErrorRefApp;
		SET OutputRoot.JSON.Data.gtid = Environment.Variables."X-Global-Transaction-Id";
		SET OutputRoot.JSON.Data.moreInformation = COALESCE(Environment.Variables.ExceptionStackTrace, '');
		
		SET OutputLocalEnvironment.Error = true;
		SET OutputLocalEnvironment.httpCode = Environment.Variables.HttpReturnCode;
		SET OutputLocalEnvironment.Destination.HTTP.RequestIdentifier= Environment.Variables.RequestIdentifier;
		SET OutputLocalEnvironment.Environment= Environment;
		RETURN TRUE;
	END;
	CREATE FUNCTION GetProperException(IN InputTree reference,OUT number_out integer, OUT text_out char, OUT stacktrace_out char)
	BEGIN

		Declare STACKTRACE CHARACTER '';
		-- Declare a reference for the ExceptionList
		-- (in a Compute node use InputExceptionList)
		DECLARE start,tempo REFERENCE TO InputExceptionList.*[1];
		-- Loop through the exception list children
		WHILE start.Number IS NOT NULL DO
			-- more ESQL
			SET STACKTRACE = start.Text ;
			-- Move start to the last child of the field to which it currently points
			MOVE tempo TO start;
			MOVE start LASTCHILD;
		END WHILE;
		if COALESCE(LENGTH(start.Text),0) > 0 then
			set text_out=start.Text;
		else
			set text_out= tempo.Text || ' : ' || start.Text;
		end if;
		
		set stacktrace_out=STACKTRACE;
		set number_out=start.Number;

	END;
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;
