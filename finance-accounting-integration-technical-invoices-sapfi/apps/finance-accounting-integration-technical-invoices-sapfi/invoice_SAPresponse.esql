

CREATE COMPUTE MODULE invoice_SAPresponse
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET Environment.Variables."invoiceReceived" = true;
		set Environment.Variables.TCSLog.context."target-system" = 'CMP05686';
		set Environment.Variables.TCSLog.context."target-system" = 'CMP05541';
		call CopyMessageHeaders();
		SET Environment.Variables.HttpReturnCode = '202';
		SET OutputLocalEnvironment.Environment= Environment;
		CREATE FIELD OutputRoot.JSON.Data;
		SET OutputLocalEnvironment.Error = false;
		RETURN TRUE;
		
	END;
	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;	
END MODULE;
